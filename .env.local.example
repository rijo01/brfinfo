NEXT_PUBLIC_SUPABASE_URL=https://DITT_PROJEKT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=din_anon_key
NEXT_PUBLIC_SITE_URL=https://brfinfo.se

# AdSense — enhets-ID (data-ad-slot) för display-enheten på /brf/[slug].
# Skapas i AdSense → Annonser → Efter annonsenhet → Display. Kontot
# (ca-pub-4694490733358572) ligger redan i layout.tsx + public/ads.txt.
# Utan denna variabel renderas ingen annonsyta alls.
NEXT_PUBLIC_ADSENSE_SLOT_BRF=1234567890

# Energi-MVP — server-side (sätts i Vercel, committas ALDRIG)
# Service-role-nyckel: används av /admin/energi-stats (läser energi_leads) och av enrichern.
SUPABASE_SERVICE_ROLE_KEY=din_service_role_key
# Skydd för /admin/energi-stats — besök /admin/energi-stats?key=<detta>
ADMIN_STATS_KEY=valfri_hemlig_strang

# Boverket — energideklarationer (krävs av brf_energi_enricher.py vid skarp körning)
# Avtal tecknas (gratis) hos Boverket; subscription-nyckel kommer via mejl.
# api-portal.boverket.se är Azure API Management → standardheader Ocp-Apim-Subscription-Key.
BOVERKET_SUBSCRIPTION_KEY=din_boverket_nyckel
# Override bara om portalen anger ett annat headernamn:
# BOVERKET_AUTH_HEADER=Ocp-Apim-Subscription-Key
# BOVERKET_API_BASE=https://api.boverket.se/energideklarationer/
# Pilot-styrning:
# PILOT_KOMMUN=Stockholm
# PILOT_LIMIT=0

# Valfri lead-notis (annars sparas leads bara i DB)
# RESEND_API_KEY=...
# ENERGI_LEAD_NOTIFY_EMAIL=rickard@exempel.se
